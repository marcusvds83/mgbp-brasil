# ============================================
# MGBP-Brasil-Middleware - Variáveis de Ambiente
# ============================================
# Middleware para emissão própria de NF-e MGBP Brasil Importação e Comércio
# Setor: Eletrodomésticos Importados (fogões, refrigeradores, cooktops, coifas)
# Copie para .env e preencha com seus dados

# --- Servidor ---
PORT=3000
NODE_ENV=production
API_KEY=troque-por-uma-chave-forte-aleatoria

# --- Odoo (https://mgbp-brasil.odoo.com) ---
ODOO_ENABLED=1
ODOO_URL=https://mgbp-brasil.odoo.com
ODOO_DB=mgbp-brasil
ODOO_USER=marcus@nytro.com.br
ODOO_API_KEY=coloque-sua-api-key-do-odoo-aqui
ODOO_POLLING_MS=20000

# --- Firebase (cofre do certificado A1 MGBP) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CERT_COLLECTION=certificados
FIREBASE_CERT_DOC_ID=mgbp-a1

# --- NF-e (SEFAZ - emissão própria) ---
NFE_EMISSAO_MODO=proprio
NFE_UF=PR  # UF do emitente (Curitiba-PR)
NFE_TP_AMB=2  # 1=produção, 2=homologação (mude para 1 após testes SEFAZ)
NFE_CERT_DIR=/var/data
NFE_CERT_KEK=chave-simétrica-forte-para-cifrar-senha-em-disco
NFE_DANFE_PROVIDER=local
NFE_TLS_INSECURE=0
NFE_STATUS_ON_ERROR=erro

# --- MGBP Brasil - parâmetros de negócio ---
MGBP_REGIME_TRIBUTARIO=lucro_presumido  # lucro_presumido | simples_nacional | lucro_real
MGBP_NCM_PADRAO=85166000  # Fogões/fornos elétricos

# --- Logs ---
LOG_LEVEL=info
